@model ResearchPortfolio.Models.Reference

@{
    ViewData["Title"] = "Edit";
}
<br />
<h2>Редактирай</h2>

<h4>Източник</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="PublicationId" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Source" class="control-label"></label>
                <input asp-for="Source" class="form-control" />
                <span asp-validation-for="Source" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2 mt-3">
                <div>
                    <a asp-controller="Publications"
                       asp-action="Details"
                       asp-route-id="@Model.PublicationId"
                       class="btn btn-secondary">
                        Назад
                    </a>
                </div>
                <div class="form-group">
                    <input type="submit" value="Запази" class="btn btn-primary" />
                </div>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
