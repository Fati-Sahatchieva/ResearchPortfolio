@model IEnumerable<ResearchPortfolio.Models.Publication>

@{
    ViewData["Title"] = "Научно Портфолио";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📚 Моите Публикации</h2>
        <a asp-controller="Publications" asp-action="Create" class="btn btn-primary">+ Нова Публикация</a>
    </div>

    <div class="table-responsive shadow-sm">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Заглавие</th>
                    <th>Година</th>
                    <th>Резюме</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    @foreach (var item in Model) {
                        <tr>
                            <td><strong>@(item.Title ?? "Няма заглавие")</strong></td>
                            <td><span class="badge bg-info text-dark">@item.Year</span></td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.Abstract))
                                {
                                    @(item.Abstract.Length > 50 ? item.Abstract.Substring(0, 50) + "..." : item.Abstract)
                                }
                                else
                                {
                                    <span>Няма резюме</span>
                                }
                            </td>
                            <td>
                                <a asp-controller="Publications" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Детайли</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>