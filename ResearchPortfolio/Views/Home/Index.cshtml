@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    @* <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p> *@
</div>
@{
    ViewData["Title"] = "Начало";
}

<div class="p-5 mb-4 bg-light rounded-3 shadow-sm border banner-gradient text-white">
    <div class="container-fluid py-5 text-center">
        <h1 class="display-5 fw-bold">Научно Портфолио</h1>
        <p class="fs-4">Управлявайте вашите публикации, изследвания и академични постижения на едно място.</p>
        <hr class="my-4 border-light">
        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
            <a asp-controller="Publications" asp-action="Index" class="btn btn-primary btn-lg px-4 gap-3">Всички публикации</a>
            @if (!User.Identity.IsAuthenticated)
            {
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-light btn-lg px-4">Регистрирай се</a>
            }
        </div>
    </div>
</div>

<div class="container mt-5">
    <div class="row text-center">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title text-primary">Сигурност</h5>
                    <p class="card-text text-muted">Вашите данни са защитени с Identity система за сигурност.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title text-primary">Организация</h5>
                    <p class="card-text text-muted">Лесно филтриране по години и автори.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title text-primary">Достъпност</h5>
                    <p class="card-text text-muted">Достъп до вашето портфолио от всяко устройство.</p>
                </div>
            </div>
        </div>
    </div>
</div>