@model ResearchPortfolio.Models.Publication

@{
    ViewData["Title"] = "Details";
}
<br />
<h2>Детайли</h2>

<div>
    <h4>Публикация</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Abstract)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Abstract)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Year)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Year)
        </dd>
    </dl>
    <hr />
    <div class="card mb-3">
        <div class="card-header">
            <strong>Автори</strong>
        </div>
        <div class="card-body">
            @if (Model.AuthorPublications.Any())
            {
                <ul class="list-group list-group-flush">
                    @foreach (var ap in Model.AuthorPublications)
                    {
                        <li class="list-group-item">@ap.User.Email</li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted">Няма добавени автори.</p>
            }
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-header">
            <strong>Референции</strong>
        </div>
        <div class="card-body">
            @if (Model.References.Any())
            {
                <ol class="list-group list-group-numbered list-group-flush">
                    @foreach (var reference in Model.References)
                    {
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong>@reference.Title</strong><br />
                                    <em>@reference.Source</em>
                                </div>

                                @if (ViewBag.IsAuthor)
                                {
                                    <div class="ms-3">
                                        <a asp-controller="References"
                                           asp-action="Edit"
                                           asp-route-id="@reference.Id"
                                           class="btn btn-sm btn-warning me-1">
                                            Редактирай
                                        </a>

                                        <form asp-controller="References"
                                              asp-action="Delete"
                                              asp-route-id="@reference.Id"
                                              method="post"
                                              style="display:inline;">
                                            <button type="submit"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Сигурни ли сте?');">
                                                Изтрий
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </li>
                    }
                </ol>
            }
            else
            {
                <p class="text-muted">Няма добавени референции.</p>
            }

            @if (ViewBag.IsAuthor)
            {
                <a asp-controller="References"
                   asp-action="Create"
                   asp-route-publicationId="@Model.Id"
                   class="btn btn-sm btn-primary mt-3">
                    Добави Референция
                </a>
            }
        </div>
    </div>
</div>
<br />
<div>
    <div class="d-flex justify-content-end gap-2 mt-3">
        <a asp-action="Index"
           class="btn btn-secondary">
            Назад
        </a>
        <a asp-action="Edit" asp-route-id="@Model?.Id" 
            class="btn btn-success">
            Редактирай
        </a>
    </div>
</div>
