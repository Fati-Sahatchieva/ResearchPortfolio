@model ResearchPortfolio.Models.Publication

@{
    ViewData["Title"] = "Create";
}
<br />
<h2>Създай</h2>

<h4>Публикация</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Abstract" class="control-label"></label>
                <input asp-for="Abstract" class="form-control text-wrap" />
                <span asp-validation-for="Abstract" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Year" class="control-label"></label>
                <input asp-for="Year" class="form-control" />
                <span asp-validation-for="Year" class="text-danger"></span>
            </div>
            <div class="form-group">
                <hr />
                <h5>Автори</h5>

                @foreach (var author in ViewBag.Authors)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="authorIds" value="@author.Id" />
                        <label class="form-check-label">@author.Email</label>
                    </div>
                }
            </div>
            <br />
            <div class="d-flex gap-2 mt-3">
                <a asp-action="Index" class="btn btn-secondary">
                    Назад
                </a>
                <br />
                <button type="submit" class="btn btn-primary">
                    Запази
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
